# Committed, non-secret defaults. Next reads this before .env.local, and
# .env.local overrides anything here — so a local override still wins.
#
# Everything in this file is PUBLIC by definition: it ends up in the exported
# HTML that every visitor downloads. Nothing secret belongs here; secrets stay
# in .env.local, which is gitignored.

# Sovrn Commerce (VigLink) publisher key. Appears verbatim in the page source of
# all 266 pages, so it is not a credential.
#
# Committed rather than left to .env.local because scripts/inject-sovrn.mjs
# reads the environment at postbuild: on any machine without a .env.local it
# would find no key, log "not injected", exit 0, and silently ship a build with
# no affiliate script — a successful-looking build that quietly earns nothing.
NEXT_PUBLIC_SOVRN_KEY=20be2ac7ea01bfc9ab29775bb26552ee
