# Affiliate network IDs.
#
# Copy to .env.local and fill in as each programme is approved.
# These are inlined into the static build, so you must rebuild after changing them.
#
# Any value left blank simply disables that network — links still render and work,
# they just go out untracked. Nothing breaks while you wait for approvals.

# Sovrn Commerce (formerly VigLink) — site key from your Sovrn dashboard.
# When set, the auto-affiliate script is injected site-wide and will monetise
# outbound merchant links automatically, including ones with no explicit network.
NEXT_PUBLIC_SOVRN_KEY=

# CJ Affiliate — your publisher ID (PID), found in the CJ dashboard.
NEXT_PUBLIC_CJ_PID=

# Walmart runs its programme through Impact. This is your Impact publisher ID.
NEXT_PUBLIC_WALMART_PID=

# eBay Partner Network — campaign ID (campid) for the Australian programme.
NEXT_PUBLIC_EBAY_CAMPID=

# Amazon Associates Australia — tracking ID, usually ends in -22.
NEXT_PUBLIC_AMAZON_TAG=
