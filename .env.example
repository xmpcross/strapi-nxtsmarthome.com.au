# Affiliate network IDs.
#
# Copy to .env.local and fill in as each programme is approved. This file is
# committed to a PUBLIC repository — every value here must stay blank. Real
# credentials belong in .env.local, which is gitignored.
# These are inlined into the static build, so you must rebuild after changing them.
#
# Any value left blank simply disables that network — links still render and work,
# they just go out untracked. Nothing breaks while you wait for approvals.

# fal.ai API key for automated cover image generation.
FAL_KEY=

# Sovrn Commerce (formerly VigLink) — site key from your Sovrn dashboard.
# When set, the auto-affiliate script is injected site-wide and will monetise
# outbound merchant links automatically, including ones with no explicit network.
NEXT_PUBLIC_SOVRN_KEY=

# CJ Affiliate — your publisher ID (PID), found in the CJ dashboard.
NEXT_PUBLIC_CJ_PID=

# Walmart runs its programme through Impact. This is your Impact publisher ID.
NEXT_PUBLIC_WALMART_PID=

# eBay Partner Network — campaign ID (campid) for the Australian programme.
NEXT_PUBLIC_EBAY_CAMPID=

# Amazon Associates Australia — tracking ID, usually ends in -22.
NEXT_PUBLIC_AMAZON_TAG=


# =============================================================================
# API CREDENTIALS — SECRET. Never prefix these with NEXT_PUBLIC_.
# =============================================================================
# Everything above is a tracking ID that already travels in a public outbound
# link, so inlining it into the browser bundle costs nothing. The values below
# are different: they authenticate as you.
#
# This site is a static export. Anything named NEXT_PUBLIC_* is baked into the
# JavaScript that ships to every visitor — a NEXT_PUBLIC_ prefix on a secret
# publishes it. These are read only by build-time scripts running in Node, so
# they must stay unprefixed.

# eBay developer keys (developer.ebay.com → your app → Production keyset).
# Used by the product enrichment script to call the Browse API. The App ID is
# the client id; the Cert ID is the client secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Marketplace to search. EBAY_AU for the Australian site.
EBAY_MARKETPLACE=EBAY_AU

# Amazon Product Advertising API 5.0. Access is only granted after three
# qualifying sales in 180 days, so expect these to stay blank for a while.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=

# DataForSEO API credentials for Google Shopping AU (location_code: 2036)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

