# nxtsmarthome.com.au — Next.js server (`next start`) behind nginx.
#
# Source of truth is /opt/projects/nxtsmarthome.com.au. `./deploy.sh` builds it
# and restarts nxtsmarthome-com-au.service on 127.0.0.1:3013. Pages revalidate
# from Strapi on their own (ISR).
#
# The 301 table is generated by scripts/gen-redirects.mjs on every build and
# included from the project, so it changes with the content instead of drifting
# inside /etc/nginx — the failure that lost 259 redirects once before.

# Keys run to ~70 characters; conf.d/00-map-hash.conf raises the bucket size to
# fit them, and has to be parsed before any map block to take effect.
map $uri $nxtsmarthome_redirect {
    default "";
    include /opt/projects/nxtsmarthome.com.au/public/_redirects.map;
}

server {
    listen 80;
    listen [::]:80;
    server_name nxtsmarthome.com.au www.nxtsmarthome.com.au;

    # Renewal is webroot-based and must answer over plain HTTP, so this stays
    # above the redirect.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot-webroot;
        default_type "text/plain";
    }

    location / {
        return 301 https://nxtsmarthome.com.au$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name nxtsmarthome.com.au www.nxtsmarthome.com.au;

    ssl_certificate /etc/letsencrypt/live/nxtsmarthome.com.au/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nxtsmarthome.com.au/privkey.pem;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log /var/log/nginx/nxtsmarthome.com.au.access.log;
    error_log  /var/log/nginx/nxtsmarthome.com.au.error.log;

    # Six months, no preload — long enough to be worth having, short enough to
    # back out of without the domain being stuck on a preload list.
    add_header Strict-Transport-Security "max-age=15768000" always;

    include snippets/nxtsmarthome-site.conf;
}
