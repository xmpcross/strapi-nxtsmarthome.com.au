{
  "name": "nxtsmarthome-com-au",
  "version": "1.0.0",
  "private": true,
  "description": "NXT Smart Home AU — smart home reviews, setup guides and buying advice for Australia",
  "scripts": {
    "dev": "node scripts/build-search-index.mjs && node scripts/fetch-nav.mjs && next dev -p 3011",
    "prebuild": "node scripts/build-search-index.mjs && node scripts/gen-redirects.mjs && node scripts/fetch-nav.mjs",
    "build": "next build",
    "start": "next start -p 3011",
    "lint": "next lint",
    "deploy": "bash scripts/deploy.sh",
    "seed:menu": "node --experimental-strip-types --env-file=.env.local scripts/seed-strapi-menu.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "new:article": "node scripts/new-article.mjs",
    "fetch:products": "node scripts/fetch-top-products.mjs",
    "fetch:products:dry": "node scripts/fetch-top-products.mjs --dry-run",
    "postbuild": "node scripts/inject-sovrn.mjs && node scripts/inject-ga.mjs",
    "deploy:preview": "bash scripts/deploy-preview.sh"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "gray-matter": "^4.0.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
